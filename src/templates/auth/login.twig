{% extends 'layout/base.twig' %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-bg-primary py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold text-text-primary" data-aos="fade-up">
                Sign in to your account
            </h2>
            <p class="mt-2 text-center text-sm text-text-secondary" data-aos="fade-up" data-aos-delay="100">
                Or 
                <a
                    href="/auth/signup"
                    class="font-medium text-accent hover:text-accent-light transition-colors"
                >
                    create a new account
                </a>
            </p>
        </div>
        
        {% if session.form_errors %}
            <div class="bg-red-500/10 border border-red-500/20 rounded-md p-4" data-aos="fade-up">
                <div class="text-sm text-red-400">
                    {% for error in session.form_errors %}
                        <p>{{ error }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        
        <form class="mt-8 space-y-6" method="POST" action="/auth/login" data-aos="fade-up" data-aos-delay="200">
            <div class="space-y-4">
                <!-- Email Input -->
                <div class="space-y-2">
                    <label for="email" class="block text-sm font-medium text-text-secondary">
                        Email address
                    </label>
                    <div class="relative">
                        <input
                            id="email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            placeholder="demo@example.com"
                            value="{{ session.old_input.email ?? '' }}"
                            class="w-full px-3 py-2 bg-bg-card border border-color-border rounded-md text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all duration-200 input-focus"
                            required
                        >
                    </div>
                </div>
                
                <!-- Password Input -->
                <div class="space-y-2">
                    <label for="password" class="block text-sm font-medium text-text-secondary">
                        Password
                    </label>
                    <div class="relative">
                        <input
                            id="password"
                            name="password"
                            type="password"
                            autocomplete="current-password"
                            placeholder="Enter your password"
                            class="w-full px-3 py-2 bg-bg-card border border-color-border rounded-md text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all duration-200 input-focus"
                            required
                        >
                    </div>
                </div>
            </div>

            <div>
                <button
                    type="submit"
                    class="group relative w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-accent hover:bg-accent-dark focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed btn-focus"
                >
                    Sign in
                </button>
            </div>

            <div class="text-center">
                <p class="text-sm text-text-muted">
                    Demo credentials: <strong>demo@example.com</strong> / <strong>password</strong>
                </p>
            </div>
        </form>
    </div>
</div>

<script>
// Add loading state to form
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const button = form.querySelector('button[type="submit"]');
    
    form.addEventListener('submit', function() {
        button.disabled = true;
        button.innerHTML = 'Signing in...';
        button.classList.add('opacity-50', 'cursor-not-allowed');
    });
});
</script>
{% endblock %}