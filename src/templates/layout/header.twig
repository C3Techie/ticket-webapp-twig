{% set user = session.ticketapp_session.user ?? null %}
{% set current_path = app.request.pathinfo %}

<header class="bg-bg-card border-b border-color-border sticky top-0 z-30">
    <div class="container">
        <div class="flex justify-between items-center h-16">
            <a href="/" class="flex items-center space-x-2">
                <svg class="h-8 w-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                </svg>
                <span class="text-xl font-bold text-text-primary">TicketFlow</span>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex space-x-8">
                <a href="/" class="px-3 py-2 rounded-md text-sm font-medium transition-colors {{ current_path == '/' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary' }}">
                    Home
                </a>
                {% if user %}
                    <a href="/dashboard" class="px-3 py-2 rounded-md text-sm font-medium transition-colors {{ current_path == '/dashboard' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary' }}">
                        Dashboard
                    </a>
                    <a href="/tickets" class="px-3 py-2 rounded-md text-sm font-medium transition-colors {{ current_path == '/tickets' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary' }}">
                        Tickets
                    </a>
                {% endif %}
            </nav>

            <!-- Desktop Auth Section -->
            <div class="hidden md:flex items-center space-x-4">
                {% if user %}
                    <div class="flex items-center space-x-2 text-text-secondary">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span class="text-sm text-text-secondary">{{ user.name }}</span>
                    </div>
                    <form action="/auth/logout" method="POST" class="inline">
                        <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-color-border rounded-md text-sm font-medium text-text-secondary bg-transparent hover:bg-bg-hover hover:text-text-primary transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary btn-focus">
                            Logout
                        </button>
                    </form>
                {% else %}
                    <div class="flex space-x-2">
                        <a href="/auth/login">
                            <button class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary btn-focus">
                                Login
                            </button>
                        </a>
                        <a href="/auth/signup">
                            <button class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-accent text-white hover:bg-accent-dark shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary btn-focus">
                                Get Started
                            </button>
                        </a>
                    </div>
                {% endif %}
            </div>

            <!-- Mobile Menu Button -->
            <div class="md:hidden flex items-center space-x-2">
                {% if user %}
                    <div class="flex items-center space-x-2 text-text-secondary mr-2">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span class="text-sm text-text-secondary">{{ user.name }}</span>
                    </div>
                {% endif %}
                <button id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-md text-text-secondary hover:text-text-primary hover:bg-bg-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-inset transition-colors duration-200" aria-label="Toggle menu">
                    <svg id="menu-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg id="close-icon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="md:hidden border-t border-color-border hidden">
            <nav class="px-2 pt-2 pb-3 space-y-1">
                <a href="/" class="block px-3 py-2 rounded-md text-base font-medium transition-colors {{ current_path == '/' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary hover:bg-bg-hover' }}">
                    Home
                </a>
                {% if user %}
                    <a href="/dashboard" class="block px-3 py-2 rounded-md text-base font-medium transition-colors {{ current_path == '/dashboard' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary hover:bg-bg-hover' }}">
                        Dashboard
                    </a>
                    <a href="/tickets" class="block px-3 py-2 rounded-md text-base font-medium transition-colors {{ current_path == '/tickets' ? 'text-accent bg-bg-hover' : 'text-text-secondary hover:text-text-primary hover:bg-bg-hover' }}">
                        Tickets
                    </a>
                {% endif %}
                
                <!-- Mobile Auth Section -->
                <div class="pt-2 border-t border-color-border">
                    {% if user %}
                        <form action="/auth/logout" method="POST" class="block">
                            <button type="submit" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-hover transition-colors duration-200">
                                Logout
                            </button>
                        </form>
                    {% else %}
                        <div class="flex flex-col space-y-2 px-2">
                            <a href="/auth/login">
                                <button class="w-full justify-center px-3 py-1.5 border border-color-border rounded-md text-sm font-medium text-text-secondary bg-transparent hover:bg-bg-hover hover:text-text-primary transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary btn-focus">
                                    Login
                                </button>
                            </a>
                            <a href="/auth/signup">
                                <button class="w-full justify-center px-3 py-1.5 rounded-md text-sm font-medium bg-accent text-white hover:bg-accent-dark shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg-primary btn-focus">
                                    Get Started
                                </button>
                            </a>
                        </div>
                    {% endif %}
                </div>
            </nav>
        </div>
    </div>
</header>

<script>
// Simple and reliable mobile menu toggle
function initMobileMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!menuButton || !mobileMenu || !menuIcon || !closeIcon) {
        console.log('Mobile menu elements not found');
        return;
    }

    function toggleMenu() {
        const isOpen = !mobileMenu.classList.contains('hidden');
        
        if (isOpen) {
            // Close menu
            mobileMenu.classList.add('hidden');
            menuIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
        } else {
            // Open menu
            mobileMenu.classList.remove('hidden');
            menuIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
        }
    }

    // Toggle menu on button click
    menuButton.addEventListener('click', function(event) {
        event.stopPropagation();
        toggleMenu();
    });

    // Close menu when clicking on links
    const menuLinks = mobileMenu.querySelectorAll('a, button');
    menuLinks.forEach(link => {
        link.addEventListener('click', function() {
            mobileMenu.classList.add('hidden');
            menuIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
        });
    });

    // Close menu when clicking outside
    document.addEventListener('click', function(event) {
        if (!mobileMenu.classList.contains('hidden') && 
            !mobileMenu.contains(event.target) && 
            !menuButton.contains(event.target)) {
            mobileMenu.classList.add('hidden');
            menuIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
        }
    });

    // Prevent menu from closing when clicking inside it
    mobileMenu.addEventListener('click', function(event) {
        event.stopPropagation();
    });
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
} else {
    initMobileMenu();
}

// Also initialize on window load as a fallback
window.addEventListener('load', initMobileMenu);
</script>

<style>
/* Button tap animation to match Framer Motion */
button:active:not(:disabled) {
    transform: scale(0.95);
    transition: transform 0.1s ease;
}

/* Ensure consistent font rendering */
* {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Force text-sm to be consistent */
.text-sm {
    font-size: 0.875rem;
    line-height: 1.25rem;
}

.text-base {
    font-size: 1rem;
    line-height: 1.5rem;
}

.text-xl {
    font-size: 1.25rem;
    line-height: 1.75rem;
}

/* Ensure mobile menu has proper z-index */
#mobile-menu {
    z-index: 40;
    background: var(--color-bg-card);
}

/* Smooth transitions for mobile menu */
#mobile-menu {
    transition: all 0.3s ease-in-out;
}

/* Focus styles */
.btn-focus:focus {
    outline: 2px solid #14b8a6;
    outline-offset: 2px;
}
</style>