<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TicketFlow - Modern Ticket Management{% endblock %}</title>
    <meta name="description" content="A modern, intuitive ticket management system for teams">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Tailwind CSS CDN with custom configuration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                container: {
                    center: true,
                    padding: {
                        DEFAULT: '1rem',
                        sm: '1rem',
                        md: '2rem',
                        lg: '2rem',
                        xl: '2rem',
                        '2xl': '2rem',
                    },
                    screens: {
                        DEFAULT: '100%',
                        xl: '1440px',
                    },
                },
                extend: {
                    colors: {
                        accent: '#14b8a6',
                        'accent-light': '#5eead4',
                        'accent-dark': '#0d9488',
                        'bg-primary': '#0f172a',
                        'bg-card': '#1e293b',
                        'bg-hover': '#334155',
                        'text-primary': '#f8fafc',
                        'text-secondary': '#cbd5e1',
                        'text-muted': '#94a3b8',
                        'status-open': '#16a34a',
                        'status-in-progress': '#f59e0b',
                        'status-closed': '#6b7280',
                        'color-border': 'rgba(255, 255, 255, 0.05)',
                    },
                    boxShadow: {
                        sm: '0 2px 8px rgba(0, 0, 0, 0.2)',
                        md: '0 8px 16px rgba(0, 0, 0, 0.3)',
                        xl: '0 25px 35px -5px rgba(0, 0, 0, 0.5)',
                    },
                    borderRadius: {
                        sm: '6px',
                        md: '10px',
                        xl: '16px',
                    },
                },
            },
        }
    </script>
    
    <style>
        /* Custom styles to match React version exactly */
        .fill-accent {
            fill: #14b8a6;
        }
        
        /* Smooth scrolling */
        html {
            scroll-behavior: smooth;
        }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #14b8a6;
            border-radius: 4px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #5eead4;
        }

        /* Focus styles for accessibility - Match React exactly */
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible {
            outline: 2px solid #14b8a6;
            outline-offset: 2px;
        }

        /* Line clamp utility */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Button focus ring styles */
        .btn-focus:focus {
            outline: 2px solid #14b8a6;
            outline-offset: 2px;
        }

        /* Input focus styles */
        .input-focus:focus {
            outline: 2px solid #14b8a6;
            outline-offset: 2px;
            border-color: transparent;
        }
    </style>
</head>
<body class="bg-bg-primary text-text-primary font-inter">
    {% include 'layout/header.twig' %}
    
    <main>
        {% block content %}{% endblock %}
    </main>
    
    {% include 'layout/footer.twig' %}
    
    <!-- AOS JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS with settings that match Framer Motion
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 500,
                once: true,
                offset: 50,
                easing: 'ease-out-cubic',
                delay: 0,
                mirror: false
            });
        });
    </script>
    
    <!-- Toast Container -->
    {% if session.toast %}
        <div id="toast" class="fixed top-4 right-4 z-50 max-w-sm w-full bg-bg-card border border-color-border rounded-lg shadow-lg p-4 transform transition-all duration-300">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    {% if session.toast.type == 'success' %}
                    <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    {% elseif session.toast.type == 'error' %}
                    <div class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    {% elseif session.toast.type == 'warning' %}
                    <div class="w-8 h-8 bg-yellow-500/20 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z" />
                        </svg>
                    </div>
                    {% else %}
                    <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    {% endif %}
                </div>
                <div class="ml-3 flex-1">
                    <p class="text-sm font-medium text-text-primary">{{ session.toast.title }}</p>
                    {% if session.toast.message %}
                    <p class="mt-1 text-sm text-text-secondary">{{ session.toast.message }}</p>
                    {% endif %}
                </div>
                <button onclick="closeToast()" class="ml-4 flex-shrink-0 text-text-secondary hover:text-text-primary transition-colors btn-focus">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
        
        <script>
            function closeToast() {
                const toast = document.getElementById('toast');
                if (toast) {
                    toast.remove();
                }
            }
            
            // Auto-close after 5 seconds
            setTimeout(closeToast, 5000);
        </script>
    {% endif %}
    
    <script src="/assets/js/main.js"></script>
</body>
</html>